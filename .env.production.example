# Production overrides — copy to .env on the server, never commit the real one.
APP_ENV=prod
LOG_LEVEL=WARNING

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=secmon
POSTGRES_USER=secmon
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET

# Tighten the allow-list in prod
SCAN_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16

# Detection tuning
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_WINDOW_SEC=300
PORTSCAN_DISTINCT_PORTS=15
PORTSCAN_WINDOW_SEC=60
