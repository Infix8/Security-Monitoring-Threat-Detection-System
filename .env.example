# ---- App ----
APP_NAME=secmon
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---- Postgres (docker service name = db) ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=secmon
POSTGRES_USER=secmon
POSTGRES_PASSWORD=change_me_in_prod

# ---- Log ingestion ----
AUTH_LOG_PATH=/var/log/auth.log
SYSLOG_PATH=/var/log/syslog

# ---- Detection thresholds ----
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_WINDOW_SEC=300
PORTSCAN_DISTINCT_PORTS=15
PORTSCAN_WINDOW_SEC=60

# ---- Scanner ----
SCAN_ALLOWED_CIDRS=127.0.0.1/32,10.0.0.0/8,192.168.0.0/16
